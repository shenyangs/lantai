  "snapshot_block_cases": [
    {
      "id": "minimax-pre-tool-snapshot-triplicate",
      "provider_id": "minimax-cn",
      "model_id": "MiniMax-M3",
      "family": "openai",
      "payload": {
        "content": [
          {"type": "thinking", "thinking": "先检查"},
          {"type": "thinking", "thinking": "先检查"},
          {"type": "thinking", "thinking": "先检查"},
          {"type": "text", "text": "开始执行"},
          {"type": "text", "text": "开始执行"},
          {"type": "text", "text": "开始执行"}
        ]
      },
      "expected_thinking": "先检查",
      "expected_text": "开始执行",
      "expected_old_difference": "duplicate-blocks-belong-to-one-provider-snapshot"
    },
    {
      "id": "ordinary-provider-preserves-identical-blocks",
