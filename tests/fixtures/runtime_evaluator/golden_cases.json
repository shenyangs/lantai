          "findings": [
            {
              "severity": "critical",
              "category": "availability",
              "message": "本地预览不可达。",
              "evidence": "Connection refused",
              "url": "http://localhost:5173/"
            }
          ]
        }
      },
      "expect": {
        "conclusion": "needs_revision",
        "category": "availability",
        "ok": false,
        "summary_contains": "本地预览不可达",
        "evidence_contains": "Connection refused"
      },
      "tags": ["preview", "availability"]
    },
