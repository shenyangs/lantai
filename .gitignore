# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.pnp
.pnp.js
node_modules/
sessions_mount_dir/

# testing
/coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
htmlcov.zip

# cookbook
cookbook/_build

# production
/build
release/
dist/
.wheelshim/
# Console frontend build (generated in Docker/CI, do not commit)
console/build/*
!console/build/icon.icns
!console/build/dmg-background-shenxingzhi.png
!console/build/dmg-background-shenxingzhi@2x.png
console/.cursor/
console/dist/
console/electron-dist/
console/release/
console/.artifacts/
console/artifacts/
console/output/
console/tmp/
# The vendored Office editors are built from source during the desktop build.
# Their renderer output is reproducible and must not inflate or dirty Git.
console/vendor/lantai-docx-editor/apps/*/out/
console/vendor/lantai-docx-editor/apps/*/generated-native/
tmp/
# Python wheel builds regenerate this bundle from console/dist. Keeping the
# generated bytes out of Git prevents every frontend build from churning the
# source tree and repository history.
src/lantai/console/

# Local, reproducible visual-review evidence. The capture scripts remain in
# source; the large screenshots belong to each developer's local workspace.
docs/assets/ui-review/
docs/assets/ui-motion/
/.artifacts/

# Local design-review output.
.impeccable/

# Stray Vite chunks occasionally appear when frontend builds run from the repo
# root. Source JS lives under subdirectories; root-level JS is generated noise.
/*.js

# frontend (website)
website/node_modules/
website/.vite/
website/tsconfig.tsbuildinfo
website/dist/
# Search index generated by scripts/build-search-index.mjs (run during build)
website/public/search-index.json

# misc
.env
.env.*
*.pem
providers.json
envs.json
!.env.example
!.env.template
__pycache__/
*.db
*.rdb
*.egg-info/
*.zip
config.json
!src/lantai/embedding_models/bge-small-zh-v1.5/config.json

